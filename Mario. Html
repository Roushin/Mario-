<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Mario: World Explorer</title>
    <style>
        body { margin: 0; overflow: hidden; background: #5c94fa; font-family: 'Arial', sans-serif; user-select: none; transition: background 1s; }
        canvas { display: block; touch-action: none; }
        #ui { position: absolute; top: 10px; left: 10px; color: white; font-size: 18px; text-shadow: 2px 2px #000; z-index: 5; pointer-events: none; }
        .controls { position: absolute; bottom: 20px; width: 100%; display: flex; justify-content: space-between; padding: 0 20px; box-sizing: border-box; }
        .btn { width: 65px; height: 65px; background: rgba(255,255,255,0.3); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: white; font-weight: bold; border: 2px solid white; touch-action: none; }
        .btn:active { background: rgba(255,255,255,0.6); }
        .d-pad, .action-btns { display: flex; gap: 10px; }
        #fireBtn { background: rgba(255, 69, 0, 0.4); display: none; }
    </style>
</head>
<body>
    <div id="ui">Stage: <span id="stageNum">1</span> | Score: <span id="score">0</span><br><span id="status">Small</span> <span id="bossHP"></span></div>
    
    <div class="controls">
        <div class="d-pad"><div class="btn" id="leftBtn">←</div><div class="btn" id="rightBtn">→</div></div>
        <div class="action-btns"><div class="btn" id="fireBtn">FIRE</div><div class="btn" id="jumpBtn">JUMP</div></div>
    </div>
    <canvas id="game"></canvas>

<script>
const canvas = document.getElementById('game');
const ctx = canvas.getContext('2d');

let score = 0, stage = 1, powerMode = 0;
let platforms = [], enemies = [], items = [], fireballs = [], clouds = [];
let pipe = null, boss = null, keys = { left: false, right: false };

// Theme Colors
const themes = {
    1: { sky: "#5c94fa", dirt: "#8b4513", grass: "#2e8b57" }, // Overworld
    2: { sky: "#1a1a2e", dirt: "#4b0082", grass: "#9370db" }, // Cave
    0: { sky: "#300", dirt: "#500", grass: "#f00" }           // Castle (Boss)
};

const player = { x: 100, y: 0, w: 30, h: 40, dy: 0, dx: 0, speed: 5, onGround: false };

function generateLevel() {
    const themeIdx = stage % 3 === 0 ? 0 : (stage % 3);
    const theme = themes[themeIdx];
    document.body.style.background = theme.sky;
    
    platforms = [{ x: 0, y: canvas.height - 100, w: 600, h: 100 }];
    enemies = []; items = []; fireballs = []; boss = null; pipe = null;
    
    // Simple clouds for Overworld
    clouds = themeIdx === 1 ? Array.from({length: 5}, () => ({x: Math.random()*canvas.width, y: Math.random()*200, w: 60})) : [];

    if (themeIdx === 0) { // BOSS LEVEL
        platforms = [{ x: 0, y: canvas.height - 100, w: canvas.width, h: 100 }];
        boss = { x: canvas.width - 150, y: canvas.height - 200, w: 80, h: 80, dy: 0, hp: 5, jumpTimer: 0 };
    } else {
        let currentX = 600;
        for(let i = 0; i < 7; i++) {
            let pY = Math.random() * (canvas.height - 350) + 250;
            let pW = Math.random() * 200 + 100;
            let newP = { x: currentX + 120, y: pY, w: pW, h: 40 };
            platforms.push(newP);
            if(Math.random() > 0.4) enemies.push({ x: newP.x + 20, y: pY - 30, w: 30, h: 30, dir: 1, parent: newP });
            if(Math.random() > 0.7) items.push({ x: newP.x + 40, y: pY - 35, w: 25, h: 25 });
            currentX = newP.x + pW;
        }
        pipe = { x: currentX + 100, y: canvas.height - 250, w: 60, h: 150 };
        platforms.push({ x: pipe.x - 20, y: canvas.height - 100, w: 200, h: 100 });
    }
    player.x = 100; player.y = canvas.height - 300;
    document.getElementById('stageNum').innerText = stage;
}

function update() {
    if (keys.left) player.dx = -player.speed; else if (keys.right) player.dx = player.speed; else player.dx = 0;
    player.dy += 0.6; player.x += player.dx; player.y += player.dy; player.onGround = false;

    // Scrolling
    if (!boss && player.x > canvas.width / 2) {
        let diff = player.x - canvas.width / 2;
        player.x = canvas.width / 2;
        platforms.forEach(p => p.x -= diff);
        enemies.forEach(e => e.x -= diff);
        items.forEach(m => m.x -= diff);
        fireballs.forEach(f => f.x -= diff);
        clouds.forEach(c => c.x -= diff * 0.3); // Parallax effect
        if(pipe) pipe.x -= diff;
    }

    platforms.forEach(p => {
        if (player.x < p.x + p.w && player.x + player.w > p.x && player.y + player.h > p.y && player.y + player.h < p.y + player.dy + 12) {
            player.y = p.y - player.h; player.dy = 0; player.onGround = true;
        }
    });

    if (boss) {
        document.getElementById('bossHP').innerText = "| BOSS HP: " + boss.hp;
        boss.jumpTimer++;
        if (boss.jumpTimer > 80) { boss.dy = -15; boss.jumpTimer = 0; }
        boss.dy += 0.5; boss.y += boss.dy;
        if (boss.y > canvas.height - 180) { boss.y = canvas.height - 180; boss.dy = 0; }
        if (player.x < boss.x + boss.w && player.x + player.w > boss.x && player.y < boss.y + boss.h && player.y + player.h > boss.y) {
            if (player.dy > 0 && player.y < boss.y + 20) { boss.hp--; player.dy = -15; } else hitPlayer();
        }
        if (boss.hp <= 0) { boss = null; pipe = { x: canvas.width - 100, y: canvas.height - 250, w: 60, h: 150 }; document.getElementById('bossHP').innerText = ""; }
    }

    fireballs.forEach((f, fi) => {
        f.x += f.dx; f.y += f.dy; f.dy += 0.4;
        if (boss && f.x < boss.x + boss.w && f.x + f.w > boss.x && f.y < boss.y + boss.h && f.y + f.h > boss.y) {
            boss.hp--; fireballs.splice(fi, 1);
        }
    });

    items.forEach((m, i) => {
        if (player.x < m.x + m.w && player.x + player.w > m.x && player.y < m.y + m.h && player.y + player.h > m.y) {
            powerMode = 2; document.getElementById('fireBtn').style.display = 'flex';
            player.h = 65; items.splice(i, 1); document.getElementById('status').innerText = "FIRE";
        }
    });

    enemies.forEach((e, i) => {
        e.x += (e.dir * 2);
        if (e.x < e.parent.x || e.x + e.w > e.parent.x + e.parent.w) e.dir *= -1;
        if (player.x < e.x + e.w && player.x + player.w > e.x && player.y < e.y + e.h && player.y + player.h > e.y) {
            if (player.dy > 0) { enemies.splice(i, 1); player.dy = -10; score += 50; } else hitPlayer();
        }
    });

    if (pipe && player.x < pipe.x + pipe.w && player.x + player.w > pipe.x && player.y < pipe.y + pipe.h && player.y + player.h > pipe.y) {
        stage++; score += 500; generateLevel();
    }

    if (player.y > canvas.height || player.x < 0) location.reload();
    document.getElementById('score').innerText = score;
}

function hitPlayer() {
    if (powerMode > 0) { powerMode = 0; player.h = 40; document.getElementById('fireBtn').style.display = 'none'; document.getElementById('status').innerText = "Small"; player.x -= 150; }
    else location.reload();
}

function draw() {
    const theme = themes[stage % 3 === 0 ? 0 : (stage % 3)];
    ctx.clearRect(0,0,canvas.width, canvas.height);
    
    // Clouds
    ctx.fillStyle = "white";
    clouds.forEach(c => { ctx.beginPath(); ctx.arc(c.x, c.y, 20, 0, Math.PI*2); ctx.arc(c.x+20, c.y-10, 20, 0, Math.PI*2); ctx.arc(c.x+40, c.y, 20, 0, Math.PI*2); ctx.fill(); });

    platforms.forEach(p => {
        ctx.fillStyle = theme.dirt; ctx.fillRect(p.x, p.y, p.w, p.h);
        ctx.fillStyle = theme.grass; ctx.fillRect(p.x, p.y, p.w, 10);
    });

    if(pipe) { ctx.fillStyle = "#228B22"; ctx.fillRect(pipe.x, pipe.y, pipe.w, pipe.h); ctx.fillStyle = "#006400"; ctx.fillRect(pipe.x-5, pipe.y, pipe.w+10, 30); }
    items.forEach(m => { ctx.fillStyle = "orange"; ctx.beginPath(); ctx.arc(m.x+12, m.y+12, 12, 0, Math.PI*2); ctx.fill(); });
    fireballs.forEach(f => { ctx.fillStyle = "orange"; ctx.beginPath(); ctx.arc(f.x+5, f.y+5, 5, 0, Math.PI*2); ctx.fill(); });
    ctx.fillStyle = powerMode === 2 ? "#fff" : "#f00"; ctx.fillRect(player.x, player.y, player.w, player.h);
    ctx.fillStyle = "#654321"; enemies.forEach(e => ctx.fillRect(e.x, e.y, e.w, e.h));
    if(boss) { ctx.fillStyle = "purple"; ctx.fillRect(boss.x, boss.y, boss.w, boss.h); ctx.fillStyle="red"; ctx.fillRect(boss.x+10, boss.y+10, 10, 10); ctx.fillRect(boss.x+60, boss.y+10, 10, 10); }
}

function gameLoop() { update(); draw(); requestAnimationFrame(gameLoop); }

document.getElementById('leftBtn').ontouchstart = () => keys.left = true;
document.getElementById('leftBtn').ontouchend = () => keys.left = false;
document.getElementById('rightBtn').ontouchstart = () => keys.right = true;
document.getElementById('rightBtn').ontouchend = () => keys.right = false;
document.getElementById('jumpBtn').ontouchstart = () => { if(player.onGround) player.dy = -13; };
document.getElementById('fireBtn').ontouchstart = () => { if(powerMode === 2) fireballs.push({x: player.x+20, y: player.y+10, w:10, h:10, dx: 8, dy: -4}); };

canvas.width = window.innerWidth; canvas.height = window.innerHeight;
generateLevel(); gameLoop();
</script>
</body>
</html>
